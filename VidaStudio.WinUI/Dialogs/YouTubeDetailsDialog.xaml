<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="VidaStudio.Dialogs.YouTubeDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="⚙️ YouTube Post Details &amp; Metadata"
    PrimaryButtonText="Save Details"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    CornerRadius="12">

    <Grid Width="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- YouTube Video Title -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="YouTube Video Title" FontSize="11" FontWeight="SemiBold" />
            <TextBox x:Name="YtTitleBox" PlaceholderText="[Official Visualizer] Song Title - Artist (60 FPS Studio Video)" />
        </StackPanel>

        <!-- YouTube Video Description -->
        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock Text="YouTube Description (Auto-formatted with Timestamps &amp; Full Lyrics)" FontSize="11" FontWeight="SemiBold" />
            <TextBox x:Name="YtDescBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Cascadia Code, Consolas" FontSize="11"
                     PlaceholderText="🎵 Song Title&#x0a;🎙️ Artist&#x0a;&#x0a;📝 Full Lyrics:&#x0a;..." />
        </StackPanel>

        <!-- YouTube Tags -->
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Tags &amp; Keywords (comma-separated)" FontSize="11" FontWeight="SemiBold" />
            <TextBox x:Name="YtTagsBox" PlaceholderText="Khmer music, Sinn Sisamouth, 60fps, 4K visualizer, bass boost" />
        </StackPanel>

        <!-- Visibility / Privacy -->
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Visibility" FontSize="11" FontWeight="SemiBold" />
            <ComboBox x:Name="YtPrivacyCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="🌐 Public" />
                <ComboBoxItem Content="🔗 Unlisted" />
                <ComboBoxItem Content="🔒 Private" />
            </ComboBox>
        </StackPanel>
    </Grid>
</ContentDialog>
