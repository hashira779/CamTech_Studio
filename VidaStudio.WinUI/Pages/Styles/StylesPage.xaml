<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VidaStudio.Pages.StylesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VidaStudio.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="🎨 Visual Styles &amp; AI Director" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Choose from 18 curated cinematic aesthetics or craft custom scenes using natural language instructions. Tailored for authentic Cambodian lighting, culture, and modern pop music."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="720" />
            </StackPanel>

            <!-- Natural Language AI Director -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Natural Language Creative Director" FontWeight="SemiBold" FontSize="16" />
                    </StackPanel>

                    <TextBox Text="{x:Bind ViewModel.DirectorPrompt, Mode=TwoWay}"
                             TextWrapping="Wrap" AcceptsReturn="True" Height="70"
                             PlaceholderText="Describe the visual scene (e.g. 'A romantic evening walking beside Phnom Penh riverside with amber streetlight reflections...')" />

                    <!-- Quick Suggestions -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Quick Prompts:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="🌅 Angkor Sunset" Click="PromptChip_Click" Tag="Majestic Angkor Wat temple towers during golden hour sunset, soft sunbeams filtering through ancient banyan trees, cinematic warm film grading." />
                        <Button Content="🌧️ Phnom Penh Rain" Click="PromptChip_Click" Tag="Reflective wet streets of Phnom Penh at night, glowing neon signs, moody emotional rain drops, cinematic anamorphic lenses." />
                        <Button Content="🌾 Rice Paddies" Click="PromptChip_Click" Tag="Idyllic emerald green Cambodian countryside, iconic sugar palm trees against blue skies, warm nostalgic film colors." />
                        <Button Content="🎉 Traditional Festival" Click="PromptChip_Click" Tag="Vibrant Water Festival floating lanterns on the Tonle Sap river, colorful dragon boat celebration, warm festive radiance." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Karaoke Kinetic Typography Styles -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="9 Auto Khmer Karaoke Animation Styles" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Ultra-smooth 60 FPS syllable-level animation with Khmer subscript protection."
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.KaraokeStyles}"
                              SelectedItem="{x:Bind ViewModel.SelectedKaraokeStyle, Mode=TwoWay}"
                              Width="260" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 18 Visual Styles Grid -->
            <TextBlock Text="18 Curated Visual Styles" FontSize="18" FontWeight="SemiBold" />

            <GridView ItemsSource="{x:Bind ViewModel.Styles}"
                      SelectedItem="{x:Bind ViewModel.SelectedStyle, Mode=TwoWay}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="StyleGridView_ItemClick">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:VisualStyle">
                        <Border Width="340" Height="140" Margin="0,0,12,12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top: Title & Khmer Badge -->
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14" />
                                            <TextBlock Text="{x:Bind KhmerName}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Category Pill -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2">
                                        <TextBlock Text="{x:Bind Category}" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0" VerticalAlignment="Top" />

                                <!-- Bottom Status / Active indicator -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Select Style" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </StackPanel>
    </ScrollViewer>
</Page>
