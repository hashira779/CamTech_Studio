<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VidaStudio.Pages.ExportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VidaStudio.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="🎬 Multi-Format Video Export" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Render high-fidelity video optimized for YouTube, TikTok, and Instagram with hardware-accelerated FFmpeg NVENC encoding."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Export Formats Grid -->
            <TextBlock Text="Target Social Platform Presets" FontSize="18" FontWeight="SemiBold" />

            <GridView ItemsSource="{x:Bind ViewModel.Presets}"
                      SelectedItem="{x:Bind ViewModel.SelectedPreset, Mode=TwoWay}"
                      SelectionMode="Single"
                      HorizontalAlignment="Stretch">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal"
                                       MaximumRowsOrColumns="4"
                                       ItemWidth="320" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ExportPreset">
                        <Border MinWidth="260" Height="150" Margin="0,0,8,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Top -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
                                    <Border Width="32" Height="32" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <FontIcon Glyph="{x:Bind IconGlyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TargetPlatform}" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Description -->
                                <TextBlock Grid.Row="1" Text="{x:Bind Description}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxLines="3"
                                           Margin="0,8,0,0" VerticalAlignment="Top" />

                                <!-- Bottom Resolution Tag -->
                                <Border Grid.Row="2" HorizontalAlignment="Left" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Resolution}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Encoding & Video Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Encoding Quality &amp; Features" FontWeight="SemiBold" FontSize="16" />

                    <Grid ColumnSpacing="24" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="*" MinWidth="240" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column -->
                        <StackPanel Grid.Column="0" Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Export Resolution" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.Resolutions}"
                                          SelectedItem="{x:Bind ViewModel.ExportResolution, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <ToggleSwitch Header="60 FPS Ultra-Smooth Video"
                                          IsOn="{x:Bind ViewModel.Enable60Fps, Mode=TwoWay}" />

                            <ToggleSwitch Header="Include Safe Area Guides"
                                          IsOn="{x:Bind ViewModel.IncludeSafeAreas, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Right Column -->
                        <StackPanel Grid.Column="1" Spacing="14">
                            <ToggleSwitch Header="Hardware NVENC Acceleration (NVIDIA GPU)"
                                          IsOn="{x:Bind ViewModel.EnableGpuAcceleration, Mode=TwoWay}" />

                            <ToggleSwitch Header="Include Animated Khmer Opening Title Card"
                                          IsOn="{x:Bind ViewModel.IncludeOpeningTitleCard, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Render Status & Action Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" FontWeight="SemiBold" FontSize="15"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Exports will be saved to Project/outputs/" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button Grid.Column="1" Click="StartExport_Click"
                                IsEnabled="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center" Padding="20,10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE714;" />
                                <TextBlock Text="Render &amp; Export Video" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}" Maximum="100" Height="6" CornerRadius="3"
                                 Visibility="{x:Bind ViewModel.IsExporting, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</Page>

