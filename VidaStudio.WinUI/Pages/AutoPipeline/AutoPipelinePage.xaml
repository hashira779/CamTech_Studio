<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VidaStudio.Pages.AutoPipelinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:VidaStudio.Models"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⚡ AUTO PERFECT" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" />
                        <Border Background="#312E81" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="12-Step AI Pipeline" FontSize="11" FontWeight="SemiBold" Foreground="#A5B4FC" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Zero-friction automated music video creation engine. Automatically synchronizes Khmer lyrics, detects beats, segments verses/choruses, and composites 60 FPS video."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="720" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Click="Reset_Click" Style="{ThemeResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Reset" />
                        </StackPanel>
                    </Button>

                    <Button Click="Start_Click" IsEnabled="{x:Bind ViewModel.IsProcessing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            Style="{ThemeResource AccentButtonStyle}" Padding="16,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" />
                            <TextBlock Text="Run 12-Step Auto Engine" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Overall Progress Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="{x:Bind ViewModel.CurrentStatusText, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{x:Bind ViewModel.OverallProgress, Mode=OneWay, Converter={StaticResource PercentConverter}}"
                                   HorizontalAlignment="Right" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Value="{x:Bind ViewModel.OverallProgress, Mode=OneWay}" Maximum="100" Height="8" CornerRadius="4" />

                    <!-- Audit info pill -->
                    <Border Grid.Row="2" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="14" />
                            <TextBlock Text="{x:Bind ViewModel.AuditSummary, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 12-Step Cards Grid -->
            <TextBlock Text="Pipeline Stages &amp; Quality Audit Inspection" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Steps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PipelineStep">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Icon / Step Badge -->
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- Middle Details -->
                                <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{x:Bind DetailMessage}" FontSize="12" Foreground="#10B981" FontWeight="Medium"
                                                   Visibility="{x:Bind DetailMessage, Converter={StaticResource StringToVisConverter}}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Description}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <!-- Right Status Indicator -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <!-- Running Ring -->
                                    <ProgressRing IsActive="{x:Bind IsRunning, Mode=OneWay}" Width="20" Height="20"
                                                  Visibility="{x:Bind IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Success Checkmark -->
                                    <FontIcon Glyph="&#xE73E;" Foreground="#10B981" FontSize="18"
                                              Visibility="{x:Bind IsSuccess, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Failed Exclamation -->
                                    <FontIcon Glyph="&#xEA39;" Foreground="#EF4444" FontSize="18"
                                              Visibility="{x:Bind IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />

                                    <!-- Pending Dot -->
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{ThemeResource TextFillColorTertiaryBrush}"
                                            Visibility="{x:Bind IsPending, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
