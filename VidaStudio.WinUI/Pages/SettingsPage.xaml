<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VidaStudio.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16,24,32">
        <StackPanel Spacing="24" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Header Section -->
            <StackPanel Spacing="6">
                <TextBlock Text="⚙️ Settings &amp; Diagnostics" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Configure Python AI backend services, hardware acceleration, and monitor live engine diagnostic telemetry."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Backend Service Status Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="VIDA AI Backend Microservice" FontWeight="SemiBold" FontSize="16" />
                            <Border Background="{x:Bind ViewModel.IsBackendReady, Mode=OneWay, Converter={StaticResource BoolToVisConverter}}"
                                    CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" />
                                    <TextBlock Text="Online (Ready)" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.BackendUrl, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.PythonPath, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1" Click="RestartBackend_Click" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" />
                            <TextBlock Text="Restart Backend" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- AI Engine & Model Settings -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="AI Models &amp; Hardware Acceleration" FontWeight="SemiBold" FontSize="16" />

                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Khmer ASR Transcription Engine" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.KhmerModels}"
                                          SelectedItem="{x:Bind ViewModel.SelectedKhmerModel, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Demucs Stem Separation Acceleration" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{x:Bind ViewModel.DemucsDevices}"
                                          SelectedItem="{x:Bind ViewModel.SelectedDemucsDevice, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Gemini API Key (Cloud AI Fast-Path)" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <PasswordBox Password="{x:Bind ViewModel.GeminiApiKey, Mode=TwoWay}"
                                             PlaceholderText="Enter Gemini API key for 1-2s instant sync" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Live Streaming Diagnostic Terminal -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel Spacing="12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE756;" />
                            <TextBlock Text="Live Backend Diagnostic Console" FontWeight="SemiBold" FontSize="16" />
                        </StackPanel>

                        <Button Click="ClearLogs_Click" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74D;" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Background="#050811" CornerRadius="8" Padding="12" Height="220" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ListView ItemsSource="{x:Bind ViewModel.BackendLogs}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" FontFamily="Cascadia Code, Consolas" FontSize="11" Foreground="#10B981" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
