                            </Border>
                        </Grid>

                        <!-- Scrollable Interactive Lyrics List -->
                        <ListView Grid.Row="1" x:Name="TeleprompterListView" SelectionChanged="TeleprompterListView_SelectionChanged"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LyricLine">
                                    <Border Margin="0,3" Padding="8,6" CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#1E1B4B" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind DisplayTime}" FontSize="9" FontFamily="Cascadia Code, Consolas" Foreground="#818CF8" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= BOTTOM MEDIA TRANSPORT BAR (Real Audio Playback) ================= -->
        <Border Grid.Row="2" Margin="16,0,16,12" Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="240" />
                </Grid.ColumnDefinitions>

                <!-- Left: Playback Buttons & Transport -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Click="Prev_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="8">
                        <FontIcon Glyph="&#xE892;" FontSize="13" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Click="PlayPause_Click" Style="{ThemeResource AccentButtonStyle}" Width="40" Height="40" CornerRadius="20">
                        <FontIcon x:Name="PlayPauseGlyph" Glyph="&#xE768;" FontSize="15" />
                    </Button>
                    <Button Click="Stop_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="8">
                        <FontIcon Glyph="&#xE71A;" FontSize="13" />
                    </Button>
                    <Button Click="Next_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="8">
                        <FontIcon Glyph="&#xE893;" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Center: Timecode & Waveform Scrubber -->
                <Grid Grid.Column="1" Margin="20,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock x:Name="CurrentTimeText" Text="00:00:00" FontSize="11" FontWeight="SemiBold" FontFamily="Cascadia Code, Consolas" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Master Waveform" HorizontalAlignment="Center" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="TotalTimeText" Text="03:45:00" HorizontalAlignment="Right" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Slider Grid.Row="1" x:Name="WaveformSlider" Minimum="0" Maximum="225" Value="0" ValueChanged="WaveformSlider_ValueChanged" />
                </Grid>

                <!-- Right: Volume & 60 FPS Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" Value="85" ValueChanged="VolumeSlider_ValueChanged" />
                    <Border Background="#1E1B4B" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="60 FPS" FontSize="11" FontWeight="Bold" Foreground="#818CF8" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
