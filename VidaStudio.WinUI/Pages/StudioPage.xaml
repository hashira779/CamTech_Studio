<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VidaStudio.Pages.StudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:VidaStudio.Services"
    xmlns:models="using:VidaStudio.Models"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    NavigationCacheMode="Required">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= TOP TOOLBAR (Native WinUI 3) ================= -->
        <Border Grid.Row="0" Margin="16,8,16,10" Padding="14,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Project Info Pill & Activity Indicator -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="#1E1B4B" CornerRadius="6" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="#818CF8" />
                            <TextBlock Text="VIDA STUDIO PRO" FontWeight="Bold" FontSize="12" Foreground="#C7D2FE" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="ProjectTitleText" Text="Project: Sinn Sisamouth - 60 FPS" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock x:Name="AudioStatsBadge" Text="128 BPM · 60 FPS · Master Audio" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                    </Border>

                    <!-- Live Activity Capsule -->
                    <Border x:Name="ActivityCapsule" Background="#312E81" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ProgressRing IsActive="True" Width="12" Height="12" Foreground="#818CF8" />
                            <TextBlock x:Name="ActivityStatusText" Text="Processing..." FontSize="10" FontWeight="SemiBold" Foreground="#C7D2FE" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center Aspect Ratio Switcher -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                    <Button x:Name="Aspect169Btn" Click="Aspect_Click" Tag="16:9" Style="{ThemeResource AccentButtonStyle}" Padding="12,6">
                        <TextBlock Text="16:9 Landscape" FontSize="11" />
                    </Button>
                    <Button x:Name="Aspect916Btn" Click="Aspect_Click" Tag="9:16" Style="{ThemeResource DefaultButtonStyle}" Padding="12,6">
                        <TextBlock Text="9:16 Vertical" FontSize="11" />
                    </Button>
                    <Button x:Name="Aspect11Btn" Click="Aspect_Click" Tag="1:1" Style="{ThemeResource DefaultButtonStyle}" Padding="12,6">
                        <TextBlock Text="1:1 Square" FontSize="11" />
                    </Button>
                </StackPanel>

                <!-- Right Action Buttons & YouTube Auto-Post -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- YouTube Auto-Post Controls -->
                    <CheckBox x:Name="YoutubeAutoPostCheck" Content="Auto-Post YT" FontSize="11" VerticalAlignment="Center" />
                    <Button Click="YoutubeDetails_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="8,4" ToolTipService.ToolTip="Customize YouTube Title, Description &amp; Tags">
                        <FontIcon Glyph="&#xE713;" FontSize="11" />
                    </Button>
                    <Button Click="YoutubeDetails_Click" Background="#450A0A" BorderBrush="#7F1D1D" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" ToolTipService.ToolTip="YouTube Channel Connect &amp; Auto-Post Settings">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🔴" FontSize="9" />
                            <TextBlock Text="YT Connect" FontSize="10" FontWeight="SemiBold" Foreground="#F87171" />
                        </StackPanel>
                    </Button>

                    <Button Click="QuickAutoPerfect_Click" Style="{ThemeResource DefaultButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE735;" Foreground="#F59E0B" />
                            <TextBlock Text="⚡ Auto Perfect" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Click="NavigateExport_Click" Style="{ThemeResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE714;" />
                            <TextBlock Text="Render Video" FontWeight="SemiBold" FontSize="12" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN 3-COLUMN WORKSPACE ================= -->
        <Grid Grid.Row="1" Margin="16,0,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="300" MaxWidth="600" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="400" MinWidth="300" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- SPLITTERS -->
            <controls:GridSplitter Grid.Column="1" Width="12" Background="Transparent" HorizontalAlignment="Center" ResizeDirection="Columns" />

            <!-- ================= LEFT PANEL: CLEAN AUTOMATION HUB ================= -->
            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Segmented Switcher Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TabLeftMediaBtn" Grid.Column="0" Click="TabLeft_Click" Tag="media"
                                Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,3,0">
                            <TextBlock Text="📁 Media Pool" FontSize="11" FontWeight="SemiBold" />
                        </Button>
                        <Button x:Name="TabLeftAiBtn" Grid.Column="1" Click="TabLeft_Click" Tag="ai"
                                Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Margin="3,0,0,0">
                            <TextBlock Text="🧠 AI &amp; Stems" FontSize="11" FontWeight="SemiBold" />
                        </Button>
                    </Grid>

                    <!-- TAB 1: MEDIA POOL (Minimalist Magic UI) -->
                    <Grid Grid.Row="1" x:Name="LeftMediaPanel" Visibility="Visible" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="250" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Massive Magic Drop Zone -->
                        <Border Grid.Row="0" x:Name="NativeDropZone" Tapped="DropZone_Tapped"
                                AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="#8B5CF6" BorderThickness="2" CornerRadius="12" Padding="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE898;" FontSize="48" Foreground="#A78BFA" HorizontalAlignment="Center" />
                                <TextBlock Text="Drop a Song File Here" FontWeight="Bold" FontSize="18" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                <TextBlock Text="MP3, WAV, M4A, FLAC or click to browse" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- YouTube Input Capsule -->
                        <Grid Grid.Row="1" RowSpacing="6" Margin="0,-4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="YouTubeUrlBox" Grid.Column="0" PlaceholderText="...or paste YouTube link" FontSize="11" Margin="0,0,4,0" Background="#1E1B4B" BorderBrush="#312E81" />
                                <Button Grid.Column="1" Click="PasteYouTube_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="8,6" Margin="0,0,4,0" ToolTipService.ToolTip="Paste from clipboard">
                                    <TextBlock Text="📋" FontSize="11" />
                                </Button>
                                <Button Grid.Column="2" Click="DownloadYouTube_Click" Style="{ThemeResource AccentButtonStyle}" Padding="10,6" ToolTipService.ToolTip="Download and extract audio">
                                    <TextBlock Text="⬇️ DL" FontSize="11" FontWeight="SemiBold" />
                                </Button>
                            </Grid>
                            <ProgressBar Grid.Row="1" x:Name="YouTubeProgressBar" Visibility="Collapsed" IsIndeterminate="True" Height="4" Foreground="#EC4899" />
                        </Grid>

                        <!-- Library Selector -->
                        <StackPanel Grid.Row="2" Spacing="4">
                            <TextBlock Text="Select Existing Track" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox x:Name="LibrarySelector" HorizontalAlignment="Stretch" 
                                      Background="#1E1B4B" BorderBrush="#312E81" 
                                      DisplayMemberPath="Name" SelectionChanged="LibrarySelector_SelectionChanged" />
                        </StackPanel>

                        <!-- Active Loaded Song Badge -->
                        <Border Grid.Row="3" Background="#1E1B4B" BorderBrush="#312E81" BorderThickness="1" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#312E81" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8D6;" Foreground="#818CF8" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="MasterTrackNameText" Text="Waiting for audio..." FontWeight="Bold" FontSize="14" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TrackArtistText" Text="Load a track to start the magic" FontSize="11" Foreground="#818CF8" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- System Font Selector -->
                        <StackPanel Grid.Row="4" Spacing="4" Margin="0,4,0,8">
                            <TextBlock Text="Magic Lyric Font" FontSize="11" Foreground="#94A3B8" />
                            <ComboBox x:Name="FontSelector" HorizontalAlignment="Stretch" SelectedIndex="0" 
                                      Background="#1E1B4B" BorderBrush="#312E81" SelectionChanged="FontSelector_SelectionChanged" />
                        </StackPanel>

                        <!-- Custom Logo Picker -->
                        <StackPanel Grid.Row="5" Spacing="4" Margin="0,0,0,12">
                            <TextBlock Text="Custom Video Logo" FontSize="11" Foreground="#94A3B8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LogoPathBox" IsReadOnly="True" PlaceholderText="Using built-in VibeTunes logo..." FontSize="11" Background="#1E1B4B" BorderBrush="#312E81" Margin="0,0,4,0" />
                                <Button Grid.Column="1" Click="BrowseLogo_Click" Style="{ThemeResource DefaultButtonStyle}" Padding="12,6">
                                    <TextBlock Text="Browse..." FontSize="11" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Giant Magic Button -->
                        <Button Grid.Row="6" Click="QuickAutoPerfect_Click" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="16,24" Background="#7C3AED" BorderBrush="#8B5CF6" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="✨ CREATE MAGIC VIDEO" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="Auto-Transcription + Auto-Theme + 60FPS Render" FontSize="11" Foreground="#C4B5FD" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        
                        <!-- Empty space filler -->
                        <Grid Grid.Row="7" />
                    </Grid>

                    <!-- TAB 2: AI & VOCAL STEMS -->
                    <ScrollViewer Grid.Row="1" x:Name="LeftAiPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="10">
                            <!-- SuperSmart Scan Button -->
                            <Button Click="RunSuperSmartScan_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="10,8">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="🧠" />
                                    <TextBlock Text="SuperSmart Scan (BPM, Key, Mood)" FontSize="11" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <!-- Auto-Sync Lyrics Stack -->
                            <StackPanel Spacing="6">
                                <Button Click="AutoSyncLyrics_Click" HorizontalAlignment="Stretch" Padding="10,8"
                                        Background="#065F46" BorderBrush="#10B981" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="🎤" />
                                        <TextBlock Text="Auto-Sync Lyrics (⚡ Gemini AI)" FontSize="11" FontWeight="Bold" Foreground="White" />
                                    </StackPanel>
                                </Button>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Click="AiFixSpelling_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,3,0" Padding="6,6">
                                        <TextBlock Text="✨ AI Fix Spelling" FontSize="10" />
                                    </Button>
                                    <Button Grid.Column="1" Click="ImportSubtitle_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Margin="3,0,0,0" Padding="6,6">
                                        <TextBlock Text="📄 Import Sub (.lrc)" FontSize="10" />
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Language & AI Model Selectors -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Vocal Language" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="VocalLanguageCombo" SelectedIndex="1" HorizontalAlignment="Stretch" FontSize="11">
                                        <ComboBoxItem Content="🌐 Auto Detect" Tag="auto" />
                                        <ComboBoxItem Content="🇰🇭 Khmer (ខ្មែរ)" Tag="km" />
                                        <ComboBoxItem Content="🇬🇧 English" Tag="en" />
                                        <ComboBoxItem Content="🇨🇳 Chinese" Tag="zh" />
                                        <ComboBoxItem Content="🇯🇵 Japanese" Tag="ja" />
                                        <ComboBoxItem Content="🇹🇭 Thai" Tag="th" />
                                        <ComboBoxItem Content="🇻🇳 Vietnamese" Tag="vi" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="AI Model" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ComboBox x:Name="AiModelCombo" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="11">
                                        <ComboBoxItem Content="⚡ Gemini AI" Tag="gemini-fast" />
                                        <ComboBoxItem Content="🇰🇭 Qwen3-ASR" Tag="qwen3-khmer" />
                                        <ComboBoxItem Content="💨 Whisper Small" Tag="small" />
                                        <ComboBoxItem Content="👑 Whisper Large-v3" Tag="large-v3-turbo" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Demucs Vocal Separation Toggle -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,4">
                                <ToggleSwitch x:Name="DemucsToggle" Header="🎧 Demucs Vocal Isolation" FontSize="11" IsOn="True" />
                            </Border>

                            <!-- Audio Stats Card -->
                            <Border Background="#0B0F19" CornerRadius="8" Padding="10" BorderBrush="#1F2937" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="BPM" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="StatBpmText" Text="128" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="Key" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="StatKeyText" Text="C Minor" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                        <TextBlock Text="Energy" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="StatEnergyText" Text="88%" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AI Khmer Lyric Composer -->
                            <Border Background="#451A03" CornerRadius="8" Padding="10" BorderBrush="#D97706" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="✍️ AI Khmer Lyric Composer" FontSize="11" FontWeight="Bold" Foreground="#FBBF24" />
                                        <Border HorizontalAlignment="Right" Background="#78350F" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="POETIC AI" FontSize="8" FontWeight="Bold" Foreground="#FEF3C7" />
                                        </Border>
                                    </Grid>
                                    <ComboBox x:Name="LyricGenreCombo" SelectedIndex="0" HorizontalAlignment="Stretch" FontSize="11">
                                        <ComboBoxItem Content="💖 Romantic Ballad (មនោសញ្ចេតនា)" Tag="romantic" />
                                        <ComboBoxItem Content="📻 1960s Golden Era (យុគមាស ស៊ីសាមុត)" Tag="golden_era" />
                                        <ComboBoxItem Content="🌧️ Melancholy &amp; Tears (កម្សត់ ព្រាត់ប្រាស)" Tag="melancholy" />
                                        <ComboBoxItem Content="🪘 Festive Romvong (រាំវង់ ចូលឆ្នាំថ្មី)" Tag="romvong" />
                                        <ComboBoxItem Content="⚡ Modern Pop &amp; Trap (តន្ត្រីយុវវ័យ)" Tag="modern_pop" />
                                        <ComboBoxItem Content="👑 Angkor Heritage (ដួងព្រលឹងអង្គរ)" Tag="heritage" />
                                    </ComboBox>
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Click="GenerateKhmerLyrics_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="6,6">
                                            <TextBlock Text="✨ Compose" FontSize="10" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Grid.Column="1" Click="PolishKhmerLyrics_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="6,6">
                                            <TextBlock Text="🪄 Fix Spelling" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Gemini AI Assistant -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock Text="🤖 Gemini AI Assistant" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <HyperlinkButton Click="PasteAiPrompt_Click" Content="📋 Paste Lyrics" HorizontalAlignment="Right" FontSize="10" Foreground="#C084FC" Padding="0" />
                                    </Grid>
                                    <TextBox x:Name="AiAssistantPromptBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap"
                                             PlaceholderText="Ask AI in Khmer or English, or paste reference lyrics..." FontSize="11" />
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Click="AskGemini_Click" Style="{ThemeResource DefaultButtonStyle}" HorizontalAlignment="Stretch" Padding="6,6">
                                            <TextBlock Text="⚡ Ask Gemini" FontSize="10" />
                                        </Button>
                                        <Button Grid.Column="1" Click="AlignPromptLyrics_Click" Style="{ThemeResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="6,6">
                                            <TextBlock Text="✨ Align Teleprompter" FontSize="10" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ================= CENTER: NATIVE CANVAS / VIDEO STAGE ================= -->
            <Border Grid.Column="2" Margin="12,0,12,0" Background="#050811"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <!-- Stage Viewport Container -->
                    <Border x:Name="StageContainer" Width="720" Height="405" CornerRadius="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            BorderBrush="#1E293B" BorderThickness="1">
                        <Border.Background>
                            <RadialGradientBrush x:Name="StageRadialBackground" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                                <GradientStop x:Name="StageGradientStop0" Color="#2E1065" Offset="0.0" />
                                <GradientStop x:Name="StageGradientStop1" Color="#090514" Offset="0.7" />
                                <GradientStop x:Name="StageGradientStop2" Color="#020108" Offset="1.0" />
                            </RadialGradientBrush>
                        </Border.Background>

                        <Grid>
                            <!-- Audio-Reactive Spectrum Bars -->
                            <StackPanel x:Name="SpectrumPanel" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,40" Spacing="5" Height="100">
                                <!-- 24 Spectrum Bars -->
                                <Rectangle Width="4" Height="25" Fill="#818CF8" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="45" Fill="#818CF8" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="65" Fill="#6366F1" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="30" Fill="#6366F1" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="80" Fill="#A855F7" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="50" Fill="#A855F7" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="95" Fill="#EC4899" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="70" Fill="#EC4899" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="40" Fill="#F43F5E" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="85" Fill="#F43F5E" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="60" Fill="#F59E0B" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="90" Fill="#F59E0B" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="60" Fill="#F59E0B" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="85" Fill="#F43F5E" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="40" Fill="#F43F5E" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
                                <Rectangle Width="4" Height="70" Fill="#EC4899" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" />
